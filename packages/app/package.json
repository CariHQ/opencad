{
  "name": "@opencad/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "clean": "rm -rf dist coverage",
    "bake:landscape": "tsx scripts/bake-landscape.ts"
  },
  "dependencies": {
    "@opencad/ai": "workspace:*",
    "@opencad/document": "workspace:*",
    "@opencad/shared": "workspace:*",
    "@opencad/sync-rs": "workspace:*",
    "@stripe/stripe-js": "^9.9.0",
    "@xyflow/react": "^12.11.1",
    "firebase": "^12.15.0",
    "i18next": "^23",
    "i18next-browser-languagedetector": "^8",
    "idb": "^7.1.1",
    "nanoid": "^5.1.16",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^15",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.10",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "i18next-scanner": "^4",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.2",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.4"
  }
}
